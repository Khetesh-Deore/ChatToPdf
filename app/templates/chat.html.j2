<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ conv.title }}</title>
<link rel="stylesheet" href="{{ vendor_url }}/katex/katex.min.css">
<style>{{ pygments_css|safe }}</style>
<style>
{% raw %}
:root {
  --ink: #1f2328;
  --muted: #6b7280;
  --bubble: #f4f4f4;
  --line: #e5e7eb;
  --accent: #10a37f;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font: 10.5pt/1.55 "Inter", "Segoe UI", "Noto Sans", "Noto Sans Devanagari",
        "Noto Sans CJK SC", "Noto Color Emoji", system-ui, sans-serif;
  color: var(--ink);
  overflow-wrap: anywhere;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

/* ---- document header ---- */
.doc-head {
  border-bottom: 1px solid var(--line);
  padding-bottom: 10px;
  margin-bottom: 18px;
}
.doc-head h1 { font-size: 18pt; line-height: 1.25; margin: 0 0 4px; }
.doc-head .sub { color: var(--muted); font-size: 8.5pt; }

/* ---- turns ---- */
.turn { margin: 0 0 16px; }
.meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 5px;
  break-after: avoid;
}
.avatar {
  width: 20px; height: 20px; border-radius: 50%;
  display: inline-block; text-align: center;
  font-size: 8pt; line-height: 20px; font-weight: 700;
  color: #fff; background: var(--accent);
}
.turn.user .avatar { background: #6b7280; }
.who { font-weight: 600; font-size: 9.5pt; }

.turn.user .body {
  background: var(--bubble);
  border-radius: 16px;
  padding: 9px 15px;
  width: fit-content;
  max-width: 88%;
  margin-left: auto;
}
.turn.user .meta { justify-content: flex-end; }
.user-text { white-space: pre-wrap; }
.body > :first-child { margin-top: 0; }
.body > :last-child  { margin-bottom: 0; }

/* ---- typography ---- */
h1, h2, h3, h4 { break-after: avoid; line-height: 1.3; margin: 1.1em 0 .4em; }
h1 { font-size: 15pt; }
h2 { font-size: 13pt; }
h3 { font-size: 11.5pt; }
h4 { font-size: 10.5pt; }
p  { margin: .55em 0; }
ul, ol { margin: .5em 0; padding-left: 1.5em; }
li { margin: .2em 0; }
a  { color: #0b66c3; text-decoration: underline; }
hr { border: 0; border-top: 1px solid var(--line); margin: 1em 0; }
blockquote {
  margin: .7em 0; padding: .1em 1em;
  border-left: 3px solid var(--line); color: #4b5563;
}

/* ---- tables ---- */
table {
  border-collapse: collapse; width: 100%;
  margin: .8em 0; font-size: 9.5pt;
}
th, td {
  border: 1px solid var(--line);
  padding: 5px 8px; vertical-align: top; text-align: left;
}
th { background: #f6f7f9; }
thead { display: table-header-group; }
tr { break-inside: avoid; }

/* ---- images ---- */
img {
  display: block; max-width: 100%; max-height: 230mm;
  height: auto; object-fit: contain;
  border-radius: 4px; margin: .6em 0; break-inside: avoid;
}
.img-missing {
  padding: 14px; border: 1px dashed var(--line);
  color: var(--muted); text-align: center;
  border-radius: 4px; margin: .6em 0;
  font-size: 9pt;
}

/* ---- inline code ---- */
:not(pre) > code {
  background: #eef0f3; padding: 1px 5px; border-radius: 3px;
  font: .9em "JetBrains Mono", "DejaVu Sans Mono", Menlo, monospace;
}

/* ---- code blocks ---- */
.code-block {
  border: 1px solid var(--line); border-radius: 6px;
  margin: .8em 0; background: #f8f9fb;
}
.code-lang {
  padding: 3px 10px;
  font: 8pt "DejaVu Sans Mono", monospace;
  color: var(--muted);
  background: #eef0f3;
  border-bottom: 1px solid var(--line);
  border-radius: 6px 6px 0 0;
  break-after: avoid;
}
.code-block pre {
  margin: 0; padding: 8px 10px;
  white-space: pre-wrap; word-break: break-word;
  font: 8.8pt/1.45 "JetBrains Mono", "DejaVu Sans Mono", Menlo, monospace;
}

/* ---- math ---- */
.math-block { text-align: center; margin: .8em 0; break-inside: avoid; }
.katex { font-size: 1.05em; }
{% endraw %}
</style>
</head>
<body>
<header class="doc-head">
  <h1>{{ conv.title }}</h1>
  <div class="sub">
    Exported {{ conv.created_at }}&nbsp;&middot;&nbsp;Source: {{ conv.source_url }}
  </div>
</header>

{% for m in conv.messages %}
<section class="turn {{ 'user' if m.role == 'user' else 'assistant' }}">
  <div class="meta">
    <span class="avatar">{{ 'U' if m.role == 'user' else 'G' }}</span>
    <span class="who">{{ 'You' if m.role == 'user' else 'ChatGPT' }}</span>
  </div>
  <div class="body">{{ m.html|safe }}</div>
</section>
{% endfor %}

<script src="{{ vendor_url }}/katex/katex.min.js"></script>
<script src="{{ vendor_url }}/katex/auto-render.min.js"></script>
<script>
{% raw %}
document.addEventListener("DOMContentLoaded", async () => {
  try {
    renderMathInElement(document.body, {
      delimiters: [
        { left: "\\[", right: "\\]", display: true  },
        { left: "\\(", right: "\\)", display: false },
        { left: "$$",  right: "$$",  display: true  }
      ],
      ignoredTags: ["script", "style", "pre", "code"],
      throwOnError: false
    });
    // Shrink display equations that are wider than the page so they fit without clipping.
    document.querySelectorAll(".math-block").forEach(el => {
      const k = el.querySelector(".katex");
      if (!k) return;
      const w = k.getBoundingClientRect().width;
      const max = el.clientWidth;
      if (w > max && max > 0) k.style.zoom = (max / w).toFixed(3);
    });
    await document.fonts.ready;
  } finally {
    window.__ready = true;
  }
});
{% endraw %}
</script>
</body>
</html>
